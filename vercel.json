{
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/hub?fn=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/hub?fn=oauth&w=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/hub?fn=oauth&w=prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/hub?fn=oauth&w=asm"
    },
    {
      "source": "/.well-known/oauth-authorization-server/mcp",
      "destination": "/api/hub?fn=oauth&w=asm"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/hub?fn=oauth&w=asm"
    },
    {
      "source": "/register",
      "destination": "/api/hub?fn=oauth&w=register"
    },
    {
      "source": "/token",
      "destination": "/api/hub?fn=oauth&w=token"
    },
    {
      "source": "/authorize",
      "destination": "/connect/index.html"
    },
    {
      "source": "/connect.sh",
      "destination": "/connect/install.sh"
    }
  ],
  "headers": [
    {
      "source": "/authorize",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/connect",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/connect/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/connect.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/connect/:file*.sh",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
